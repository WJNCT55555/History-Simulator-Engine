{
  "name": "history-simulator-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Historical political simulation engine and complete game authoring studio",
  "scripts": {
    "predev": "npm run build:player",
    "dev": "vite",
    "editor": "npm run dev",
    "dev:game": "npm run build:player && vite --open /",
    "build:player": "node scripts/build-player.mjs",
    "build": "npm run build:player && vite build",
    "lint": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "verify": "npm run lint && npm test && npm run build",
    "export": "npm run build:player && tsx scripts/export-game.ts"
  },
  "dependencies": {
    "lucide-react": "0.546.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "5.2.0",
    "esbuild": "0.28.2",
    "tsx": "4.21.0",
    "typescript": "5.8.3",
    "vite": "6.4.4"
  },
  "engines": {
    "node": ">=20.19"
  },
  "overrides": {
    "esbuild": "$esbuild"
  }
}
