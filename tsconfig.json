{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": [
      "node",
      "vite/client"
    ]
  },
  "include": [
    "src/engine",
    "src/projects",
    "src/runtime",
    "src/main.tsx",
    "editor/server.ts",
    "scripts/export-game.ts",
    "tests",
    "vite.config.ts",
    "editor/src"
  ]
}
